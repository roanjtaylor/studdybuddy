;;; The first map: how a computer works, from a switch to a model that writes code.
;;; One form per line. Edit by hand; (load-map "computers") re-reads it.
;;; Prerequisite order flows down each group and across groups left to right.

(:map :id "computers" :title "Computers" :compression "A switch controls a switch; everything else is layers of programs loading programs.")

(:group :id "switches" :compression "A switch can control another switch.")
(:group :id "stored-program" :compression "Instructions are data in the same memory.")
(:group :id "loaders" :compression "Every layer is a program that loads the next.")
(:group :id "sharing" :compression "Many programs share one machine.")
(:group :id "languages" :compression "Languages are compressions over machine code.")
(:group :id "network" :compression "Machines talk.")
(:group :id "learned" :compression "Programs can be found, not written.")

;;; switches
(:node :id "transistor" :title "Transistor as a switch" :compression "A small voltage at one terminal lets or blocks a current between two others, so one signal can control another." :why "Every computer is billions of these and nothing else is physical; all the rest is arrangement." :group "switches" :prereqs () :era 1947)
(:node :id "logic-gates" :title "Logic gates" :compression "Two switches in series is AND, in parallel is OR, one that inverts is NOT; every other function is made of these." :why "Boolean logic becomes hardware: a claim about truth is now a circuit you can buy." :group "switches" :prereqs ("transistor") :era 1938)
(:node :id "adder" :title "Adding with gates" :compression "XOR gives the sum bit and AND the carry; chain one per bit and you add numbers of any width." :why "Arithmetic is wiring, not thinking. The CPU never 'knows' numbers." :group "switches" :prereqs ("logic-gates") :era 1937)
(:node :id "clock" :title "The clock" :compression "A square wave tells every gate when to look at its inputs, turning a chaos of signals into a sequence of steps." :why "Time inside a computer is discrete because of this. Every 'cycle' you ever hear about is one tick." :group "switches" :prereqs ("logic-gates") :era 1945)
(:node :id "flip-flop" :title "Flip-flop as one bit of memory" :compression "Two gates wired in a loop hold a value until pushed." :why "This is one bit of RAM. Memory is just a loop." :group "switches" :prereqs ("logic-gates" "clock") :era 1918)
(:node :id "ram" :title "RAM as an addressed grid" :compression "A decoder turns an address number into one selected row of flip-flops you can read or overwrite." :why "The address is the first abstraction: a number names a place. Pointers, arrays and files all descend from it." :group "switches" :prereqs ("flip-flop" "adder") :era 1968)

;;; stored-program
(:node :id "fetch-decode-execute" :title "The fetch-decode-execute loop" :compression "Read the word at the program counter, work out which operation it names, do it, move on, forever." :why "This loop is the whole CPU; everything else is speed. Nothing a computer does is not this." :group "stored-program" :prereqs ("ram" "clock") :era 1945)
(:node :id "registers-pc" :title "Registers and the program counter" :compression "A handful of fast words inside the CPU; one of them, the PC, holds the address of the next instruction." :why "The PC is the computer's single thread of attention. Jumps, calls and interrupts are all just writes to it." :group "stored-program" :prereqs ("flip-flop") :era 1945)
(:node :id "instruction-set" :title "The instruction set" :compression "The fixed menu of operations the hardware understands, each a bit pattern with fields naming the operation and its operands." :why "The ISA is the contract between the hardware and every program ever written for it; change it and all software breaks." :group "stored-program" :prereqs ("fetch-decode-execute" "registers-pc") :era 1964)
(:node :id "machine-code-assembly" :title "Machine code and assembly" :compression "Assembly is machine code with names instead of numbers; an assembler is a lookup table inside a loop." :why "The first program that writes programs. From here on, programs are text." :group "stored-program" :prereqs ("instruction-set") :era 1949)
(:node :id "reset-vector-bootstrap" :title "Reset vector and bootstrap" :compression "At power-on the PC is forced to a fixed address in ROM, and whatever program sits there runs first." :why "There is no magic at startup: the machine begins by executing an address someone chose." :group "stored-program" :prereqs ("fetch-decode-execute") :era 1951)
(:node :id "code-and-data-alike" :title "Code and data in one memory" :compression "Instructions are just numbers in RAM, so a program can read, write and generate other programs." :why "This one decision makes compilers, loaders and interpreters possible, and also every buffer-overflow exploit." :group "stored-program" :prereqs ("fetch-decode-execute" "ram") :era 1945)

;;; loaders
(:node :id "firmware-uefi" :title "Firmware (BIOS/UEFI)" :compression "The program in ROM at the reset vector: it checks the hardware, finds a disk, copies the next program into RAM and jumps to it." :why "The first loader. Everything after it is software that was loaded by software." :group "loaders" :prereqs ("reset-vector-bootstrap") :era 1981)
(:node :id "bootloader" :title "The bootloader" :compression "A small program whose only job is to find the kernel on disk, put it in memory and hand over the PC." :why "Each layer is too big for the layer below to load directly, so there is a chain of ever larger loaders." :group "loaders" :prereqs ("firmware-uefi") :era 1992)
(:node :id "kernel" :title "The kernel" :compression "The one program that runs with full power over the hardware and lends it, piece by piece, to every other program." :why "Everything you call 'the operating system' is this program plus the programs it loads." :group "loaders" :prereqs ("bootloader" "code-and-data-alike") :era 1969)
(:node :id "drivers" :title "Device drivers" :compression "Kernel code that turns 'write these bytes' into the exact register pokes one particular device needs." :why "Hardware diversity is hidden here, so every program above sees the same few verbs." :group "loaders" :prereqs ("kernel") :era 1969)
(:node :id "shell" :title "The shell" :compression "A program that reads a line, finds a program by that name, and asks the kernel to run it with the rest of the line as arguments." :why "The first user interface, and still the one every other is a wrapper around." :group "loaders" :prereqs ("kernel") :era 1971)
(:node :id "editor" :title "The editor" :compression "A program that holds a file in memory as text and writes it back; the tool every other program is written in." :why "Programs are text files, so the editor is where software is born, including the next editor." :group "loaders" :prereqs ("shell") :era 1976)
(:node :id "lisp-image" :title "The Lisp image" :compression "A running program whose entire state, including its own compiler, can be saved to disk and resumed." :why "Loading becomes resuming: the layer you edit is the layer that is running." :group "loaders" :prereqs ("editor" "code-and-data-alike") :era 1962)

;;; sharing
(:node :id "processes-threads" :title "Processes and threads" :compression "A process is a program plus its own memory; a thread is one program counter and stack inside it." :why "The unit the kernel shares the machine between. Everything you run is one of these." :group "sharing" :prereqs ("kernel" "registers-pc") :era 1965)
(:node :id "scheduler" :title "The scheduler" :compression "On a timer tick the kernel stops the running program, saves its registers, restores another's and jumps; 'at the same time' is a trick." :why "One CPU appears to be many. Concurrency bugs are this trick showing through." :group "sharing" :prereqs ("processes-threads" "clock") :era 1962)
(:node :id "virtual-memory" :title "Virtual memory" :compression "Every address a program uses is translated through a table the kernel owns, so each program sees its own private memory." :why "Programs cannot read or corrupt each other, and memory can be larger than RAM." :group "sharing" :prereqs ("ram" "processes-threads") :era 1962)
(:node :id "files" :title "Files" :compression "A name mapped to a sequence of bytes on a disk; a directory is a file that lists other files." :why "Persistence and naming in one idea. Almost everything the kernel offers is made to look like a file." :group "sharing" :prereqs ("kernel" "drivers") :era 1965)
(:node :id "syscall-boundary" :title "The system call boundary" :compression "A program asks the kernel for something with a special instruction that raises privilege, passes a number, and drops it again on return." :why "The only door between a program and the hardware. Every library call eventually ends here or stays in user space." :group "sharing" :prereqs ("kernel" "instruction-set") :era 1969)
(:node :id "os-as-referee" :title "The OS as referee" :compression "The kernel exists to share the hardware fairly and keep programs from touching each other; everything else it does is convenience." :why "Explains why an OS is needed at all, and what it is not: it is not the desktop, the shell or the apps." :group "sharing" :prereqs ("scheduler" "virtual-memory" "syscall-boundary") :era 1969)

;;; languages
(:node :id "compiler-vs-interpreter" :title "Compiler versus interpreter" :compression "A compiler translates a whole program into machine code once; an interpreter reads and performs it a piece at a time while it runs." :why "The two ways a text becomes behaviour. Everything from Python to the CPU's own microcode sits somewhere between." :group "languages" :prereqs ("machine-code-assembly" "code-and-data-alike") :era 1957)
(:node :id "call-stack" :title "The call stack" :compression "Each function call pushes its return address and locals; a return pops them, so calls nest and recursion is free." :why "Functions, locals and recursion are all this one data structure. A stack overflow is it running out." :group "languages" :prereqs ("registers-pc" "ram") :era 1960)
(:node :id "garbage-collection" :title "Garbage collection" :compression "Memory a program can no longer reach is found by walking from the roots and freed automatically." :why "Removes a whole class of bugs by making the runtime, not the programmer, account for memory." :group "languages" :prereqs ("call-stack") :era 1959)
(:node :id "code-as-data" :title "Code as data" :compression "When programs are written as the language's own data structures, a program can read, build and rewrite programs." :why "Macros, interpreters-in-the-language and the whole bottom-up style follow from it." :group "languages" :prereqs ("compiler-vs-interpreter" "code-and-data-alike") :era 1960)
(:node :id "image-and-repl" :title "The image and the REPL" :compression "Read a form, evaluate it inside the running program, print the result; the program grows while it runs." :why "Development without restarting. The program is a living thing you converse with, not a file you rebuild." :group "languages" :prereqs ("code-as-data" "lisp-image") :era 1962)
(:node :id "types" :title "Types" :compression "A type is a claim about what a value is, checked before a run (static) or during it (dynamic) so wrong combinations are caught." :why "The main tool for making a compiler catch your mistakes, and the main argument in language design." :group "languages" :prereqs ("compiler-vs-interpreter") :era 1973)

;;; network
(:node :id "packets-ip" :title "Packets and IP" :compression "A message is cut into addressed envelopes that each find their own way across the network; nothing in the middle keeps state." :why "Statelessness in the middle is why the internet scales and why it can lose, duplicate or reorder anything." :group "network" :prereqs ("os-as-referee") :era 1974)
(:node :id "tcp" :title "TCP" :compression "Number the packets, acknowledge each, resend the lost ones, and an unreliable network becomes a reliable ordered stream." :why "Reliability is built on top of unreliability, in software, at the edges." :group "network" :prereqs ("packets-ip") :era 1974)
(:node :id "sockets" :title "Sockets" :compression "The kernel's file-like handle for a network connection: open, read, write, close." :why "A connection to another machine becomes just another thing a program reads and writes." :group "network" :prereqs ("tcp" "files" "syscall-boundary") :era 1983)
(:node :id "http" :title "HTTP" :compression "A text request naming a resource, a text response carrying it; stateless, one exchange at a time." :why "The lingua franca of the web, and why every web app has to invent its own way to remember you." :group "network" :prereqs ("sockets") :era 1991)
(:node :id "browser-as-renderer" :title "The browser as renderer" :compression "A program that fetches text over HTTP, parses it into a tree, and paints the tree." :why "The browser is a document viewer that got a programming language; everything on the web is drawn by it." :group "network" :prereqs ("http") :era 1990)
(:node :id "client-server" :title "Client and server" :compression "One program waits and answers; many programs ask. Where the state lives decides what the program is." :why "The shape of almost every networked system, and the question behind every architecture argument." :group "network" :prereqs ("sockets") :era 1984)
(:node :id "web-as-app-platform" :title "The web as application platform" :compression "Send the browser a program along with the page, and the server becomes the thing the program talks to." :why "Turns a document viewer into the universal runtime; most software you use arrives this way." :group "network" :prereqs ("browser-as-renderer" "client-server") :era 1995)

;;; learned
(:node :id "neuron-weighted-sum" :title "The neuron as a weighted sum" :compression "Multiply each input by a weight, add them up, squash the result: a tiny adjustable function." :why "The unit everything in machine learning is made of; there is no cleverness inside it." :group "learned" :prereqs ("adder") :era 1943)
(:node :id "gradient-training" :title "Training by gradient descent" :compression "Measure the error, compute how each weight moved it, nudge every weight the other way, repeat millions of times." :why "The program is not written; it is found by this loop. Learning is just optimisation with a lot of parameters." :group "learned" :prereqs ("neuron-weighted-sum") :era 1986)
(:node :id "transformer" :title "The transformer" :compression "Each token looks at every other token, weighs how much it matters, and mixes in what it finds; stacked many times, this reads." :why "The architecture behind every current language model; attention replaced recurrence and made training parallel." :group "learned" :prereqs ("gradient-training") :era 2017)
(:node :id "next-token" :title "Next-token prediction" :compression "Train on one objective: given the text so far, guess the next piece. Everything else emerges from doing that well." :why "The surprising fact of the era: one dumb objective at scale yields reasoning, code and conversation." :group "learned" :prereqs ("transformer") :era 2018)
(:node :id "model-as-loop-plus-weights" :title "A model is a loop plus weights" :compression "Inference is a fixed program running the same arithmetic over billions of learned numbers; the weights are the program." :why "Demystifies the model: a file of numbers and a short loop that applies them, nothing hidden." :group "learned" :prereqs ("next-token" "fetch-decode-execute") :era 2020)
(:node :id "gpu-inference" :title "GPUs and inference" :compression "Thousands of simple cores do the same multiply-add in lockstep, and a model's arithmetic fits that shape exactly." :why "Why models run on graphics cards and why compute, not ideas, bounds what can be trained." :group "learned" :prereqs ("model-as-loop-plus-weights" "clock") :era 2012)
(:node :id "wrapper-as-app-layer" :title "The wrapper as application layer" :compression "A program that assembles context, calls the model, reads its answer and acts on it; the new shell." :why "Where the model meets the rest of the stack: tools, files, the web. Most AI products are this loop." :group "learned" :prereqs ("model-as-loop-plus-weights" "web-as-app-platform" "shell") :era 2022)
